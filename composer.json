{
  "name": "monkeyscloud/monkeyslegion-openapi",
  "description": "Automatic OpenAPI 3.1 specification generator and Swagger UI middleware for the MonkeysLegion framework.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "openapi",
    "swagger",
    "documentation",
    "api-docs",
    "monkeyslegion"
  ],
  "authors": [
    {
      "name": "MonkeysCloud",
      "email": "jorge@monkeys.cloud"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../router",
      "options": { "symlink": true },
      "canonical": false
    },
    {
      "type": "path",
      "url": "../http",
      "options": { "symlink": true },
      "canonical": false
    }
  ],
  "require": {
    "php": "^8.4",
    "monkeyscloud/monkeyslegion-router": "dev-main",
    "monkeyscloud/monkeyslegion-http": "dev-2.x-dev as 1.99.x-dev",
    "psr/http-message": "^2.0",
    "psr/http-server-middleware": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "MonkeysLegion\\OpenApi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MonkeysLegion\\OpenApi\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "2.0.x-dev"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
